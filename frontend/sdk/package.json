{
  "name": "@traceboard/sdk",
  "version": "0.1.0",
  "description": "TraceBoard S3 runtime SDK (click/fetch/XHR/wrapFn/uiEffect facts; no build plugin, no sourcemap, no CDN)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/traceboard-sdk.iife.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:iife",
    "build:iife": "esbuild src/index.ts --bundle --format=iife --global-name=TraceBoardSDK --target=es2018 --outfile=dist/traceboard-sdk.iife.js --legal-comments=none --minify=false --define:__TRACEBOARD_IIFE__=true",
    "pretest": "npm run build",
    "test": "node --test test/sdk.test.js test/iife.test.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "~5.7.3"
  }
}
