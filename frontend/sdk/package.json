{
  "name": "@traceboard/sdk",
  "version": "0.1.0",
  "description": "TraceBoard S3 runtime SDK (click/fetch/XHR/wrapFn/uiEffect facts; no build plugin, no sourcemap, no CDN)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/sdk.test.js"
  },
  "devDependencies": {
    "typescript": "~5.7.3"
  }
}
