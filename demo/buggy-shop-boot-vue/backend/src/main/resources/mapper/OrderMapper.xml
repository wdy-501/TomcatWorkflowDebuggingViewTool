<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shop.mapper.OrderMapper">

  <resultMap id="OrderMap" type="com.example.shop.model.Order">
    <id column="id" property="id"/>
    <result column="order_no" property="orderNo"/>
    <result column="status" property="status"/>
    <result column="amount" property="amount" javaType="double"/>
  </resultMap>

  <select id="findAll" resultMap="OrderMap">
    SELECT id, order_no, status, amount FROM orders ORDER BY id
  </select>

  <select id="countById" resultType="int">
    SELECT COUNT(*) FROM orders WHERE id = #{id}
  </select>

</mapper>
