<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Standalone project on purpose: NOT a module of the TraceBoard root reactor. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>demo-shop-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>demo-shop-backend</name>
  <description>S2 demo shop backend (Boot 2.7.18 / Java 8): H2 + MyBatis, intentional case-A 0-row cancel defect</description>

  <properties>
    <java.version>1.8</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Boot 2.7.18 does not manage the MyBatis starter: pin it explicitly (s2-plan.md 6.1). -->
    <mybatis-spring-boot.version>2.3.1</mybatis-spring-boot.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>${mybatis-spring-boot.version}</version>
    </dependency>
    <!-- Embedded only; version managed by Boot 2.7.18 (= 2.1.214), never pinned by hand. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        S6b no-debug build (docs/contracts/api.v1.md Appendix G, event-model.v1.md 4.4.9):
        NoDebugService is compiled normally above, then recompiled here with javac debug="false"
        (-g:none: NO LocalVariableTable / LineNumberTable / SourceFile) overwriting ONLY its class
        file in target/classes. process-classes runs after compile and before package, so the
        stripped class is what ends up in the Boot jar. The classpath keeps @Service intact.
        JDK8 reports java.home=<jdk>/jre (no javac there), so the JDK bin is resolved explicitly.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>no-debug-service</id>
            <phase>process-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <condition property="tb.javac.home" value="${java.home}">
                  <available file="${java.home}/bin/javac.exe"/>
                </condition>
                <condition property="tb.javac.home" value="${java.home}/..">
                  <and>
                    <not>
                      <isset property="tb.javac.home"/>
                    </not>
                    <available file="${java.home}/../bin/javac.exe"/>
                  </and>
                </condition>
                <condition property="tb.javac.home" value="${env.JAVA_HOME}">
                  <and>
                    <not>
                      <isset property="tb.javac.home"/>
                    </not>
                    <isset property="env.JAVA_HOME"/>
                  </and>
                </condition>
                <!-- Ant's javac skips "up to date" targets (class newer than source); remove ONLY
                     this class so the stripped version is always rebuilt in this phase. -->
                <delete file="${project.build.outputDirectory}/com/example/shop/service/NoDebugService.class"/>
                <javac srcdir="${project.build.sourceDirectory}"
                       destdir="${project.build.outputDirectory}"
                       includes="com/example/shop/service/NoDebugService.java"
                       debug="false"
                       includeantruntime="false"
                       source="1.8"
                       target="1.8"
                       encoding="UTF-8"
                       fork="true"
                       executable="${tb.javac.home}/bin/javac.exe">
                  <classpath refid="maven.compile.classpath"/>
                </javac>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>