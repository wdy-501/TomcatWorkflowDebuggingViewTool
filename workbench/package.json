{
  "name": "traceboard-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TraceBoard 1.0.0 workbench (generic Java tracing UI)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:site": "vue-tsc --noEmit && vite build --mode site --base ./ --outDir dist-site --emptyOutDir",
    "build:packaged": "vue-tsc --noEmit && vite build --mode packaged --outDir dist-packaged --emptyOutDir",
    "preview": "vite preview"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}