{
  "schema": "traceboard.expected-facts.v1",
  "caseId": "s2-zero-row-chain",
  "stage": "S2",
  "pathSyntax": "dot-separated segments; a numeric segment indexes an array; the leaf value is compared with deep JSON equality",
  "derivedPathSyntax": "paths starting with '#trace.' are computed over the whole source before fact lookup: threwCount (spans with status THREW), spanCount (eventCount), rootCount (spans with parentSpanId=null), kindCount (spans per kind, object)",
  "note": "S2 zero-row chain facts ONLY. This file is deterministic test data for the S2 gate; the runtime proof of a real 0-row UPDATE comes from the H2+MyBatis demo + javaagent E2E (dispatch §1 item 1), never from this fixture. A fixture-only fake can NOT substitute the runtime demo.",
  "sources": {
    "chain": {
      "file": "fixtures/s2-zero-row-chain/events.ndjson",
      "format": "ndjson",
      "lineCount": 4,
      "eventCount": 4
    }
  },
  "globalAssertions": {
    "chain": {
      "sessionId": "s_s2agent",
      "eventCount": 4,
      "traceId": "9f8e7d6c5b4a39281706f5e4d3c2b1a0",
      "rootSpanId": "1a2b3c4d5e6f7a80",
      "rootEventId": "click_lost_1a2b3c4d5e6f7a80",
      "rootEventIdPrefix": "click_lost_",
      "rootEventIdSuffixIsRootSpanId": true,
      "singleRoot": true,
      "rootKind": "controller",
      "rootParentSpanId": null,
      "confidenceAllLost": true,
      "statusAllOk": true,
      "noExceptions": true,
      "noThrewStatus": true,
      "noReason": true,
      "noValues": true,
      "parentChain": [
        "1a2b3c4d5e6f7a80",
        "2b3c4d5e6f7a8091",
        "3c4d5e6f7a8091a2",
        "4d5e6f7a8091a2b3"
      ],
      "kindChain": ["controller", "service", "mapper", "sql"],
      "startNsNonDecreasing": true,
      "intervalContainment": true,
      "intervalNested": true,
      "durNsPositive": true,
      "threadAllEqual": "http-nio-8080-exec-1",
      "flagsRootExact": ["S2_ZERO_ROW_CHAIN", "LOST_BACKEND"],
      "flagsChildrenExact": ["S2_ZERO_ROW_CHAIN"],
      "flagsLostBackendOnlyOnRoot": true,
      "sqlRowsAffectedZero": true,
      "sqlTransaction": "UNKNOWN"
    }
  },
  "facts": [
    {
      "id": "F1",
      "source": "chain",
      "kind": "controller",
      "nodeKey": "com.example.shop.controller.OrderController#cancel",
      "status": "OK",
      "assert": {
        "path": "return.value",
        "value": 200
      },
      "summary": "Controller 收到真实 HTTP 200（ResponseEntity 状态码 200，由 agent 反射读取）；0 行 SQL 与 200 同时成立正是案例 A 的事实组合"
    },
    {
      "id": "F2",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#cancel",
      "status": "OK",
      "assert": {
        "path": "return.value",
        "value": true
      },
      "summary": "Service 忽略 Mapper 的 0，正常返回 boolean true（OK，不是 THREW）"
    },
    {
      "id": "F3",
      "source": "chain",
      "kind": "mapper",
      "nodeKey": "com.example.shop.mapper.OrderMapper#cancelById",
      "status": "OK",
      "assert": {
        "path": "return.value",
        "value": 0
      },
      "summary": "Mapper 方法正常返回 int 0；0 是正常返回值的事实，不是错误状态"
    },
    {
      "id": "F4",
      "source": "chain",
      "kind": "sql",
      "nodeKey": "OrderMapper.cancelById",
      "status": "OK",
      "assert": {
        "path": "sideEffects.0.rowsAffected",
        "value": 0
      },
      "summary": "UPDATE ... AND status='PAID' 对 status=CREATED 的行影响 0 行；transaction=UNKNOWN 表示 S2 未采集事务边界，不猜测 COMMITTED"
    },
    {
      "id": "F5",
      "source": "chain",
      "kind": "controller",
      "nodeKey": "com.example.shop.controller.OrderController#cancel",
      "status": "OK",
      "assert": {
        "path": "#trace.threwCount",
        "value": 0
      },
      "summary": "整条 4-span 链没有任何 THREW：0 行不是异常，Service/Controller 也没有抛错（异常 0）"
    },
    {
      "id": "F6",
      "source": "chain",
      "kind": "controller",
      "nodeKey": "com.example.shop.controller.OrderController#cancel",
      "status": "OK",
      "assert": {
        "path": "#trace.spanCount",
        "value": 4
      },
      "summary": "一次 cancel 请求产生恰好 4 个 span（controller → service → mapper → sql），同 traceId/rootEventId，父子链完整"
    }
  ]
}
