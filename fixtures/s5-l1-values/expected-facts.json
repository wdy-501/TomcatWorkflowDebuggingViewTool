{
  "schema": "traceboard.expected-facts.v1",
  "caseId": "s5-l1-values",
  "stage": "S5",
  "pathSyntax": "dot-separated segments; a numeric segment indexes an array; the leaf value is compared with deep JSON equality",
  "derivedPathSyntax": "paths starting with '#trace.' are computed over the whole source before fact lookup: spanCount, kindCount (spans per kind, object), fetchCount, backendSpanCount, hasFrontend, hasBackend, valuesSpanCount (spans that carry a values array), valueCount (total value items), l1FlagSpanCount (spans whose flags contain L1), sourceMappedSpanCount (spans whose flags contain SOURCE_MAPPED), localValueCount (value items with kind=local)",
  "note": "S5 L1 fixture ONLY. This file is deterministic contract shape, NOT runtime evidence: the real 100->0 / redaction / truncation facts are produced by demo previewDiscount + javaagent E2E (dispatch S5-B). Never cite this directory as proof that the runtime supports L1, L2, object deep-capture or x3. source.line=120 is illustrative (the build plugin emits the real line; tests recompute it from the source file).",
  "sources": {
    "chain": {
      "file": "fixtures/s5-l1-values/events.ndjson",
      "format": "ndjson",
      "lineCount": 4,
      "eventCount": 4
    }
  },
  "eventCount": 4,
  "globalAssertions": {
    "chain": {
      "sessionId": "s_s5values",
      "eventCount": 4,
      "traceId": "5a6b7c8d9e0f1a2b3c4d5e6f708192a3",
      "rootSpanId": "a000000000000001",
      "rootEventId": "click_5f5e5d5c5b5a4938",
      "rootEventIdIsClickId": true,
      "rootEventIdNotClickLost": true,
      "singleRoot": true,
      "rootKind": "ui_event",
      "rootParentSpanId": null,
      "rootConfidence": "EXACT",
      "confidenceAllExact": true,
      "statusAllOk": true,
      "statuses": ["OK", "OK", "OK", "OK"],
      "noExceptions": true,
      "noThrewStatus": true,
      "noReason": true,
      "noLostBackendFlag": true,
      "parentBySpanId": {
        "a000000000000001": null,
        "a000000000000002": "a000000000000001",
        "a000000000000003": "a000000000000002",
        "a000000000000004": "a000000000000003"
      },
      "kindChain": ["ui_event", "fetch", "controller", "service"],
      "startNsNonDecreasing": true,
      "intervalContainment": true,
      "intervalNested": true,
      "rootIntervalContainsAll": true,
      "clickWindow": { "startNs": 7000000000, "endNs": 7042000000 },
      "threadFrontendAllEqual": "browser-main",
      "threadBackendAllEqual": "http-nio-8080-exec-1",
      "controllerParentIsFetchSpan": true,
      "fetchSpanIdIsTraceparentParentId": "a000000000000002",
      "clickIdIsTraceBoardClickHeader": "click_5f5e5d5c5b5a4938",
      "flagsClick": ["SDK_ACTIVE", "SOURCE_MAPPED", "OBSERVE_MS=1500"],
      "flagsFetch": ["SDK_ACTIVE"],
      "flagsController": ["S2_ZERO_ROW_CHAIN"],
      "flagsService": ["S2_ZERO_ROW_CHAIN", "L1"],
      "flagsAreContainsOnly": true,
      "flagsRuntimeAssertion": "runtime flags may append advisory flags (DROP_COUNT / S3_*); assert includes('L1') / includes('SOURCE_MAPPED') where applicable and absence of VALUES_CAPPED / L1_SKIPPED; never compare these arrays to runtime with deep equality",
      "controllerReturn": { "type": "org.springframework.http.ResponseEntity", "value": 200 },
      "serviceReturn": { "type": "double", "value": 0 },
      "valuesOnlyOnSpanId": "a000000000000004",
      "valuesEventCount": 1,
      "noValuesOnKinds": ["ui_event", "fetch", "controller"],
      "valuesFieldOmittedOnOtherSpans": true,
      "valueCount": 5,
      "valueNames": ["requestedAmount", "demoSecret", "note", "amount", "return"],
      "valueParamNames": ["requestedAmount", "demoSecret", "note"],
      "idParamAbsent": true,
      "valueKinds": ["param", "param", "param", "field", "return"],
      "valueLineAllNull": true,
      "valueInvocationAbsent": true,
      "valueKeyOrder": ["name", "kind", "line", "from", "to", "truncated", "redacted"],
      "valueKeyOrderIsContractual": false,
      "valueKeyOrderNote": "array order (param -> field -> return) is contractual; key order inside each value item and inside the event object is NOT contractual, compare by JSON semantics",
      "requestedAmountTo": 100,
      "demoSecretTo": "[REDACTED len=6]",
      "demoSecretRedacted": true,
      "demoSecretRawAbsent": true,
      "noteTruncated": true,
      "noteToBytes": 2048,
      "noteToLength": 2048,
      "noteToMatches": "^x{2048}$",
      "amountFrom": 100,
      "amountTo": 0,
      "returnValue": 0,
      "l1FlagPresent": true,
      "l2FlagAbsent": true,
      "noLocalKind": true,
      "noValuesCappedFlag": true,
      "noL1SkippedFlag": true,
      "controllerValuesAbsent": true,
      "serviceSource": { "file": "OrderService.java", "line": 63 },
      "controllerSource": { "file": "OrderController.java", "line": 57 },
      "clickSource": { "file": "src/App.vue", "line": 120 },
      "clickSourceLineIsIndicative": true,
      "sourceMappedOnClickRoot": true,
      "sourceMappedOnlyOnClickRoot": true,
      "noMapperOrSqlSpan": true,
      "backendSpanCount": 2,
      "graphNodeKeyCount": 15,
      "graphNodeKeysOrdered": [
        "spanId", "parentSpanId", "kind", "nodeKey", "status", "return", "sideEffects",
        "startNs", "durNs", "thread", "flags", "reason", "source", "confidence", "values"
      ]
    }
  },
  "facts": [
    {
      "id": "F1",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#previewDiscount",
      "status": "OK",
      "assert": { "path": "values.0.to", "value": 100 },
      "summary": "参数层可见：requestedAmount=100（kind=param、from=null、line=null、未脱敏未截断）"
    },
    {
      "id": "F2",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#previewDiscount",
      "status": "OK",
      "assert": { "path": "values.1.to", "value": "[REDACTED len=6]" },
      "summary": "demoSecret 命中名称正则 secret：to 只有占位符 [REDACTED len=6]、redacted=true；原值 s3cr3t 不出现在事件的任何字段"
    },
    {
      "id": "F3",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#previewDiscount",
      "status": "OK",
      "assert": { "path": "values.2.truncated", "value": true },
      "summary": "note 超过 2KB：to 恰为前 2048 个 x（UTF-8 2048 字节、不追加省略号）、truncated=true；事件 status 仍是 OK（值级标记不改状态）"
    },
    {
      "id": "F4",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#previewDiscount",
      "status": "OK",
      "assert": { "path": "values.3.from", "value": 100 },
      "summary": "字段层可见旧值：Order#setAmount 写入前 amount=100（kind=field、from 是读到的旧值）"
    },
    {
      "id": "F5",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#previewDiscount",
      "status": "OK",
      "assert": { "path": "values.3.to", "value": 0 },
      "summary": "100 -> 0 在字段层可见：同一 field 值项 to=0（恰一条字段写入；MyBatis hydration 的 0->100 已被排除）"
    },
    {
      "id": "F6",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#previewDiscount",
      "status": "OK",
      "assert": { "path": "values.4.to", "value": 0 },
      "summary": "返回值可见：kind=return、to=0，与 return={type:double,value:0} 一致"
    },
    {
      "id": "F7",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#previewDiscount",
      "status": "OK",
      "assert": { "path": "#trace.l1FlagSpanCount", "value": 1 },
      "summary": "只有 service span 带 L1 阶段标记；controller/click/fetch 不带 L1，也没有 L2"
    },
    {
      "id": "F8",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#previewDiscount",
      "status": "OK",
      "assert": { "path": "#trace.localValueCount", "value": 0 },
      "summary": "没有任何 kind=local 的值项：局部变量/行级变量属 L2/S6，S5 不采集"
    },
    {
      "id": "F9",
      "source": "chain",
      "kind": "ui_event",
      "nodeKey": "#btn-discount",
      "status": "OK",
      "assert": { "path": "#trace.sourceMappedSpanCount", "value": 1 },
      "summary": "manifest 命中只发生在带 data-tb-fn=previewDiscount 的 click 根（source=src/App.vue:120 + SOURCE_MAPPED）；后端 source 来自 JVM 栈，不带该 flag"
    },
    {
      "id": "F10",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#previewDiscount",
      "status": "OK",
      "assert": { "path": "#trace.valuesSpanCount", "value": 1 },
      "summary": "只有 service 携带 values；其余 3 个 span 省略 values 字段（graph 里呈现为 null）"
    }
  ],
