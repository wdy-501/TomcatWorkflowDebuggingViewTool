  "facts": [
    {
      "id": "F1",
      "source": "chain",
      "kind": "ui_event",
      "nodeKey": "#btn-cancel",
      "status": "OK",
      "assert": {
        "path": "confidence",
        "value": "EXACT"
      },
      "summary": "SDK 在浏览器内直接观测到点击：ui_event 根（#btn-cancel）confidence=EXACT，flags 含 SDK_ACTIVE/S3_RUNTIME_SDK/OBSERVE_MS=1500；rootEventId 是真实 clickId（不是 click_lost_ 占位）"
    },
    {
      "id": "F2",
      "source": "chain",
      "kind": "fetch",
      "nodeKey": "POST /api/orders/1/cancel",
      "status": "OK",
      "assert": {
        "path": "return.value",
        "value": 200
      },
      "summary": "浏览器 fetch 收到 HTTP 200；该 fetch 的 spanId=2000000000000002 就是 traceparent 的 parent-id 与 controller.parentSpanId"
    },
    {
      "id": "F3",
      "source": "chain",
      "kind": "controller",
      "nodeKey": "com.example.shop.controller.OrderController#cancel",
      "status": "OK",
      "assert": {
        "path": "parentSpanId",
        "value": "2000000000000002"
      },
      "summary": "agent 读取 traceparent/X-TraceBoard-Click 后，controller 的 parentSpanId 精确指向 fetch span、rootEventId=clickId、confidence=EXACT（无 LOST_BACKEND）；HTTP 200"
    },
    {
      "id": "F4",
      "source": "chain",
      "kind": "service",
      "nodeKey": "com.example.shop.service.OrderService#cancel",
      "status": "OK",
      "assert": {
        "path": "return.value",
        "value": true
      },
      "summary": "Service 忽略 Mapper 的 0，正常返回 boolean true（EXACT 继承，不是 THREW）"
    },
    {
      "id": "F5",
      "source": "chain",
      "kind": "mapper",
      "nodeKey": "com.example.shop.mapper.OrderMapper#cancelById",
      "status": "OK",
      "assert": {
        "path": "return.value",
        "value": 0
      },
      "summary": "Mapper 正常返回 int 0；0 是正常返回值事实，不是错误状态"
    },
    {
      "id": "F6",
      "source": "chain",
      "kind": "sql",
      "nodeKey": "OrderMapper.cancelById",
      "status": "OK",
      "assert": {
        "path": "sideEffects.0.rowsAffected",
        "value": 0
      },
      "summary": "UPDATE ... AND status='PAID' 影响 0 行；transaction=UNKNOWN 表示未采集事务边界，不猜 COMMITTED"
    },
    {
      "id": "F7",
      "source": "chain",
      "kind": "render",
      "nodeKey": "ui_effect:操作成功",
      "status": "OK",
      "assert": {
        "path": "return.value",
        "value": "操作成功"
      },
      "summary": "显式 uiEffect('操作成功') 的 DOM 效果事实（return.type=ui_effect），不是像素回放/截图；render 在 fetch 结束后启动，仍在 click 根区间内"
    },
    {
      "id": "F8",
      "source": "chain",
      "kind": "ui_event",
      "nodeKey": "#btn-cancel",
      "status": "OK",
      "assert": {
        "path": "#trace.threwCount",
        "value": 0
      },
      "summary": "整条 7-event 链没有任何 THREW：0 行不是异常，Service/Controller 也没有抛错"
    }
  ],
