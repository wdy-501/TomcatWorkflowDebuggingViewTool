  "stage": "S3",
  "pathSyntax": "dot-separated segments; a numeric segment indexes an array; the leaf value is compared with deep JSON equality",
  "derivedPathSyntax": "paths starting with '#trace.' are computed over the whole source before fact lookup: spanCount, threwCount, kindCount (spans per kind, object), fetchCount, backendSpanCount, hasFrontend, hasBackend, rootConfidence, clickId (rootEventId of the single ui_event root)",
  "note": "S3 case-A joined chain facts ONLY. This file is deterministic contract shape, NOT runtime evidence: the real EXACT join is produced by the browser runtime SDK (traceparent + X-TraceBoard-Click) plus the javaagent E2E (dispatch §1 item 2, S3-D). Runtime case A normally also captures the post-success GET /api/orders refresh inside the same click window, so runtime fetchCount is >=1 (the linked POST fetch is the one whose spanId is the controller parent); this fixture keeps exactly one fetch for a minimal joined chain. Never use this fixture to impersonate the runtime 0-row or EXACT facts.",
  "sources": {
    "chain": {
      "file": "fixtures/s3-frontend-facts/case-a-joined-chain/events.ndjson",
      "format": "ndjson",
      "lineCount": 7,
      "eventCount": 7
    }
  },
  "globalAssertions": {
    "chain": {
