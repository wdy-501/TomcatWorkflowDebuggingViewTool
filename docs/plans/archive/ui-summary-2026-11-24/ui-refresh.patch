+  color: var(--text-dim);
+  font-size: 10px;
+  padding: 0 5px;
+}
+
+.flow-tree__kind {
+  color: var(--text-dim);
+  font-size: 10px;
+}
+
+.flow-tree__status {
+  border: 1px solid var(--border);
+  border-radius: 4px;
