+/* Top-down rectangular flow tree (pure CSS connectors, no graph library). */
+.s3-tree__canvas {
+  overflow-x: auto;
+  padding: 10px 4px 12px;
+}
+
+.s3-tree__root {
+  display: flex;
+  justify-content: center;
+  min-width: max-content;
+}
+
+.flow-tree__branch {
+  align-items: center;
+  display: flex;
+  flex-direction: column;
+  padding: 0 5px;
+}
+
+.flow-tree__node {
+  background: var(--surface-alt);
+  border: 1px solid var(--border);
+  border-left: 3px solid var(--border);
+  border-radius: 6px;
+  cursor: pointer;
+  max-width: 230px;
+  min-width: 168px;
+  padding: 7px 9px;
+  position: relative;
+}
+
+.flow-tree__node--ok {
+  border-left-color: rgba(63, 185, 80, 0.7);
+}
+
+.flow-tree__node--false {
+  background: rgba(210, 153, 34, 0.06);
+  border-left-color: #d29922;
+}
+
+.flow-tree__node--threw {
+  background: rgba(248, 81, 73, 0.08);
+  border-left-color: #f85149;
+}
+
+.flow-tree__node--notcollected {
+  border-left-color: #5b6775;
+  border-left-style: dashed;
+}
+
+.flow-tree__node--truncated {
+  background: repeating-linear-gradient(
+    45deg,
+    rgba(143, 156, 173, 0.07) 0 6px,
+    transparent 6px 12px
+  );
+  border-left-color: #8f9cad;
+}
+
+.flow-tree__node--redacted,
+.flow-tree__node--unknown {
+  border-left-color: #8f9cad;
+}
+
+.flow-tree__node--leaf {
+  border-style: dashed;
+}
+
+.flow-tree__node--selected {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 1px rgba(74, 158, 255, 0.38);
+}
+
+.flow-tree__head {
+  align-items: center;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 5px;
+}
+
+.flow-tree__step {
+  align-items: center;
+  background: var(--accent);
+  border-radius: 50%;
+  color: #0b1016;
+  display: inline-flex;
+  flex: none;
+  font-family: var(--mono);
